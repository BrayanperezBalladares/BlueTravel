## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# ?? CRÍTICO: Archivos con credenciales sensibles
**/appsettings.Development.json
**/secrets.json
**/appsettings.Production.json

# User Secrets (no subir a GitHub)
UserSecrets/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2022 cache/options directory
.vs/
.vscode/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio code coverage results
*.coverage
*.coveragexml

# SQL Server files
*.mdf
*.ldf
*.ndf

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# NuGet Symbol Packages
*.snupkg
**/[Pp]ackages/*

# Web workbench (sass)
.sass-cache/

# TypeScript cache
*.tsbuildinfo

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Node modules (si usas npm/yarn)
node_modules/
npm-debug.log
yarn-error.log

# wwwroot (archivos generados)
wwwroot/lib/
wwwroot/dist/
wwwroot/css/site.min.css
wwwroot/js/site.min.js

# Rider
.idea/
*.sln.iml

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Azure publish profiles
*.pubxml
*.azurePubxml
*.PublishSettings

# Package Files
*.zip
*.tar.gz
*.rar

# Backup files
*.bak
*.backup
*~

# JetBrains Rider
.idea/
*.sln.iml

# Entity Framework Migrations (opcional, comentar si quieres versionarlas)
# **/Migrations/

# Local development database
*.db
*.db-shm
*.db-wal
