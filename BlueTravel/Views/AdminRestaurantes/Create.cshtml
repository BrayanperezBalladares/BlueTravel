@model BlueTravel.Models.Restaurante

@{
    ViewData["Title"] = "Crear Restaurante";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">
                        <i class="bi bi-plus-circle me-2"></i>
                        Crear Nuevo Restaurante
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control form-control-lg" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TipoComida" class="form-label fw-bold"></label>
                                <input asp-for="TipoComida" class="form-control" 
                                       placeholder="Ej: Italiana, Mariscos, Japonesa..." />
                                <span asp-validation-for="TipoComida" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Ubicacion" class="form-label fw-bold"></label>
                                <input asp-for="Ubicacion" class="form-control" />
                                <span asp-validation-for="Ubicacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Especialidad" class="form-label fw-bold"></label>
                            <textarea asp-for="Especialidad" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Especialidad" class="text-danger"></span>
                            <small class="text-muted">Describe los platos especiales o destacados</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrecioPromedio" class="form-label fw-bold"></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">?</span>
                                <input asp-for="PrecioPromedio" class="form-control" type="number" step="0.01" />
                                <span class="input-group-text">por persona</span>
                            </div>
                            <span asp-validation-for="PrecioPromedio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImagenUrl" class="form-label fw-bold"></label>
                            <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                            <small class="text-muted">URL de la imagen (ej: desde Unsplash)</small>
                        </div>

                        <div class="alert alert-info border-0">
                            <i class="bi bi-lightbulb me-2"></i>
                            <strong>Consejos:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Usa nombres atractivos y descriptivos</li>
                                <li>Especifica el tipo de cocina claramente</li>
                                <li>Menciona los platillos más populares</li>
                            </ul>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning btn-lg px-5 text-dark">
                                <i class="bi bi-check-circle me-2"></i>Crear Restaurante
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
