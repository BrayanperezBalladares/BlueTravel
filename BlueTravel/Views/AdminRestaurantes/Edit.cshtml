@model BlueTravel.Models.Restaurante

@{
    ViewData["Title"] = $"Editar: {Model.Nombre}";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar Restaurante: @Model.Nombre
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control form-control-lg" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TipoComida" class="form-label fw-bold"></label>
                                <input asp-for="TipoComida" class="form-control" />
                                <span asp-validation-for="TipoComida" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Ubicacion" class="form-label fw-bold"></label>
                                <input asp-for="Ubicacion" class="form-control" />
                                <span asp-validation-for="Ubicacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Especialidad" class="form-label fw-bold"></label>
                            <textarea asp-for="Especialidad" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Especialidad" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrecioPromedio" class="form-label fw-bold"></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">?</span>
                                <input asp-for="PrecioPromedio" class="form-control" type="number" step="0.01" />
                                <span class="input-group-text">por persona</span>
                            </div>
                            <span asp-validation-for="PrecioPromedio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImagenUrl" class="form-label fw-bold"></label>
                            <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning btn-lg px-5 text-dark">
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
