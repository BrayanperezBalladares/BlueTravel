<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlueTravel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Navbar Mejorado -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="logo-circle">
                    <i class="bi bi-airplane-fill"></i>
                </div>
                <span class="logo-text">BlueTravel</span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Nav Items -->
            <div class="collapse navbar-collapse" id="mainNav">
                <!-- Right Menu: User/Admin (le damos prioridad en móvil) -->
                <ul class="navbar-nav ms-auto user-nav order-0 order-lg-2 mb-3 mb-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Admin Menu -->
                            <li class="nav-item dropdown me-lg-3 mb-2 mb-lg-0">
                                <a class="nav-link dropdown-toggle admin-menu-toggle w-100 d-flex justify-content-between align-items-center" href="#" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <span><i class="bi bi-speedometer2 me-1"></i>Panel</span>
                                    <i class="bi bi-chevron-down small"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 animate-dropdown admin-dropdown-scroll">
                                    <li class="dropdown-header">
                                        <i class="bi bi-shield-check text-primary me-2"></i>
                                        <strong>Administrador</strong>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-graph-up me-2 text-primary"></i>Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="dropdown-header"><small class="text-muted">GESTIÓN DE CONTENIDO</small></li>
                                    <li><a class="dropdown-item" asp-controller="AdminHospedajes" asp-action="Index"><i class="bi bi-building me-2 text-primary"></i>Hospedajes</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminTours" asp-action="Index"><i class="bi bi-compass me-2 text-success"></i>Tours</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminRestaurantes" asp-action="Index"><i class="bi bi-cup-hot me-2 text-warning"></i>Restaurantes</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminOfertas" asp-action="Index"><i class="bi bi-percent me-2 text-danger"></i>Ofertas</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="dropdown-header"><small class="text-muted">OPERACIONES</small></li>
                                    <li><a class="dropdown-item" asp-controller="Reservas" asp-action="AdminIndex"><i class="bi bi-calendar-check me-2 text-success"></i>Reservas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Pagos" asp-action="AdminIndex"><i class="bi bi-credit-card me-2 text-warning"></i>Pagos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reportes"><i class="bi bi-file-earmark-text me-2 text-info"></i>Reportes</a></li>
                                </ul>
                            </li>
                        }

                        <!-- User Dropdown -->
                        <li class="nav-item dropdown mb-2 mb-lg-0">
                            <a class="nav-link dropdown-toggle user-menu-toggle d-flex align-items-center gap-2 w-100" 
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar"><i class="bi bi-person-fill"></i></div>
                                <span class="d-lg-inline">Mi Cuenta</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 animate-dropdown admin-dropdown-scroll">
                                <li class="dropdown-header d-flex align-items-center gap-2">
                                    <div class="user-avatar-lg"><i class="bi bi-person-fill"></i></div>
                                    <div>
                                        <strong class="d-block">@User.Identity?.Name</strong>
                                        <small class="text-muted">
                                            @if (User.IsInRole("Admin")) { <span class="badge bg-gradient-primary">Administrador</span>; } else { <span class="badge bg-light text-dark">Cliente</span>; }
                                        </small>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Reservas" asp-action="Index"><i class="bi bi-calendar-event me-2 text-primary"></i>Mis Reservas</a></li>
                                <li><a class="dropdown-item" asp-controller="Pagos" asp-action="Index"><i class="bi bi-receipt me-2 text-success"></i>Mis Pagos</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-person-circle me-2 text-info"></i>Mi Perfil</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2 text-secondary"></i>Configuración</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- Guest Menu -->
                        <li class="nav-item mb-2 mb-lg-0">
                            <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión</a>
                        </li>
                        <li class="nav-item ms-lg-2 mb-2 mb-lg-0">
                            <a class="btn btn-primary rounded-pill px-4 w-100" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus me-1"></i>Registrarse</a>
                        </li>
                    }
                </ul>

                <!-- Left Menu -->
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 primary-nav order-1 order-lg-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Catalogo" asp-action="Hospedajes">
                            <i class="bi bi-building me-1"></i>Hospedajes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Catalogo" asp-action="Tours">
                            <i class="bi bi-compass me-1"></i>Tours
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Catalogo" asp-action="Restaurantes">
                            <i class="bi bi-cup-hot me-1"></i>Restaurantes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Catalogo" asp-action="Ofertas">
                            <i class="bi bi-percent me-1"></i>Ofertas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            <i class="bi bi-info-circle me-1"></i>Nosotros
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- Footer Mejorado -->
    <footer class="footer-modern bg-dark text-white py-5 mt-5">
        <div class="container">
            <!-- Top Section -->
            <div class="row g-4">
                <!-- Columna 1: Sobre BlueTravel -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand mb-3">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="logo-circle-footer">
                                <i class="bi bi-airplane-fill"></i>
                            </div>
                            <h4 class="mb-0 fw-bold">BlueTravel</h4>
                        </div>
                        <p class="text-muted small mb-3">
                            Tu compañero de confianza para descubrir las maravillas de Guanacaste, Costa Rica. 
                            Experiencias únicas, hospedajes de calidad y tours inolvidables.
                        </p>
                        <!-- Redes Sociales -->
                        <div class="social-links d-flex gap-2">
                            <a href="#" class="btn btn-sm btn-outline-light rounded-circle" title="Facebook">
                                <i class="bi bi-facebook"></i>
                            </a>
                            <a href="#" class="btn btn-sm btn-outline-light rounded-circle" title="Instagram">
                                <i class="bi bi-instagram"></i>
                            </a>
                            <a href="#" class="btn btn-sm btn-outline-light rounded-circle" title="Twitter">
                                <i class="bi bi-twitter"></i>
                            </a>
                            <a href="#" class="btn btn-sm btn-outline-light rounded-circle" title="WhatsApp">
                                <i class="bi bi-whatsapp"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Columna 2: Enlaces Rápidos -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase">Explora</h6>
                    <ul class="list-unstyled footer-links">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Catalogo" asp-action="Hospedajes" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Hospedajes
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Catalogo" asp-action="Tours" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Tours
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Catalogo" asp-action="Restaurantes" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Restaurantes
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Catalogo" asp-action="Ofertas" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Ofertas
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Columna 3: Información -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase">Información</h6>
                    <ul class="list-unstyled footer-links">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Acerca de Nosotros
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Términos y Condiciones
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Política de Privacidad
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Preguntas Frecuentes
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">
                                <i class="bi bi-chevron-right me-1"></i>Blog de Viajes
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Columna 4: Contacto -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase">Contacto</h6>
                    <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-geo-alt-fill text-primary me-2 mt-1"></i>
                            <span class="text-muted small">
                                Liberia, Guanacaste<br>
                                Costa Rica
                            </span>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="bi bi-envelope-fill text-primary me-2"></i>
                            <a href="mailto:info@bluetravel.com" class="text-muted text-decoration-none small">
                                info@bluetravel.com
                            </a>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="bi bi-telephone-fill text-primary me-2"></i>
                            <a href="tel:+50612345678" class="text-muted text-decoration-none small">
                                +506 1234-5678
                            </a>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="bi bi-clock-fill text-primary me-2"></i>
                            <span class="text-muted small">
                                Lun - Vie: 8:00 AM - 6:00 PM<br>
                                Sáb: 9:00 AM - 2:00 PM
                            </span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <!-- Bottom Section -->
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <p class="mb-0 text-muted small">
                        &copy; @DateTime.Now.Year <strong>BlueTravel</strong>. Todos los derechos reservados.
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end align-items-center gap-3">
                        <span class="text-muted small">Aceptamos:</span>
                        <i class="fab fa-cc-visa fa-2x text-muted"></i>
                        <i class="fab fa-cc-mastercard fa-2x text-muted"></i>
                        <i class="fab fa-cc-paypal fa-2x text-muted"></i>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- ✅ SEMANA 4: Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ✅ SEMANA 4: TempData Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div data-success-message="@TempData["SuccessMessage"]" style="display:none;"></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div data-error-message="@TempData["ErrorMessage"]" style="display:none;"></div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div data-warning-message="@TempData["WarningMessage"]" style="display:none;"></div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div data-info-message="@TempData["InfoMessage"]" style="display:none;"></div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>