@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="row w-100">
        <div class="col-lg-6 mx-auto">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-5 text-center">
                    @if (Model?.StatusCode == 404)
                    {
                        <!-- Error 404 -->
                        <div class="error-icon mb-4">
                            <i class="bi bi-compass text-primary" style="font-size: 5rem;"></i>
                        </div>
                        <h1 class="display-4 fw-bold mb-3">404</h1>
                        <h2 class="h4 mb-3">Página no encontrada</h2>
                        <p class="text-muted mb-4">
                            Lo sentimos, la página que buscas no existe o ha sido movida.
                        </p>
                    }
                    else if (Model?.StatusCode == 403)
                    {
                        <!-- Error 403 Forbidden -->
                        <div class="error-icon mb-4">
                            <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
                        </div>
                        <h1 class="display-4 fw-bold mb-3">403</h1>
                        <h2 class="h4 mb-3">Acceso Denegado</h2>
                        <p class="text-muted mb-4">
                            No tienes permisos para acceder a esta página.
                        </p>
                    }
                    else if (Model?.StatusCode == 500)
                    {
                        <!-- Error 500 -->
                        <div class="error-icon mb-4">
                            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 5rem;"></i>
                        </div>
                        <h1 class="display-4 fw-bold mb-3">500</h1>
                        <h2 class="h4 mb-3">Error del Servidor</h2>
                        <p class="text-muted mb-4">
                            Algo salió mal en nuestro servidor. Estamos trabajando para solucionarlo.
                        </p>
                    }
                    else
                    {
                        <!-- Error genérico -->
                        <div class="error-icon mb-4">
                            <i class="bi bi-exclamation-circle text-danger" style="font-size: 5rem;"></i>
                        </div>
                        <h1 class="display-4 fw-bold mb-3">¡Oops!</h1>
                        <h2 class="h4 mb-3">Algo salió mal</h2>
                        <p class="text-muted mb-4">
                            Ha ocurrido un error inesperado. Por favor, intenta de nuevo.
                        </p>
                    }

                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="alert alert-light border mt-4">
                            <small class="text-muted">
                                <strong>ID de Solicitud:</strong> @Model.RequestId
                            </small>
                        </div>
                    }

                    <!-- Acciones -->
                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill">
                            <i class="bi bi-house-door me-2"></i>
                            Volver al Inicio
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i>
                            Regresar
                        </button>
                    </div>

                    <!-- Información de ayuda -->
                    <div class="mt-5 pt-4 border-top">
                        <p class="text-muted mb-2">
                            <i class="bi bi-question-circle me-2"></i>
                            ¿Necesitas ayuda?
                        </p>
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-controller="Home" asp-action="About" class="text-decoration-none">
                                <i class="bi bi-envelope me-1"></i>
                                Contacto
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips de navegación -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-lightbulb text-warning me-2"></i>
                        Sugerencias
                    </h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Explora nuestros <a asp-controller="Catalogo" asp-action="Hospedajes">Hospedajes</a>
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Descubre <a asp-controller="Catalogo" asp-action="Tours">Tours increíbles</a>
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Revisa nuestras <a asp-controller="Catalogo" asp-action="Ofertas">Ofertas especiales</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .error-icon i {
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
        }

        .card {
            animation: fadeInUp 0.5s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}
