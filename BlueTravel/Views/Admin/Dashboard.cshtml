@using BlueTravel.Models
@model DashboardStats

@{
    ViewData["Title"] = "Dashboard Administrativo";
}

<!-- ? SEMANA 5: DASHBOARD MEJORADO CON GRÁFICAS -->

<!-- Header del Dashboard -->
<div class="dashboard-header bg-gradient-primary text-white py-4 mb-4 rounded">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-2">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard Administrativo
                </h1>
                <p class="lead mb-0">Panel de control y estadísticas de BlueTravel</p>
            </div>
            <div class="col-md-4 text-end">
                <small class="d-block">Última actualización</small>
                <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
        </div>
    </div>
</div>

<!-- Métricas Principales (KPIs) -->
<div class="row g-4 mb-4">
    <!-- Total Reservas -->
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="stat-icon bg-primary bg-opacity-10 rounded p-3">
                        <i class="bi bi-calendar-check text-primary fs-2"></i>
                    </div>
                    <h5 class="text-muted mb-0">Reservas</h5>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalReservas</h2>
                <small class="text-success">
                    <i class="bi bi-arrow-up"></i> @Model.CrecimientoMensual.ToString("F1")% este mes
                </small>
            </div>
        </div>
    </div>

    <!-- Ingresos Totales -->
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="stat-icon bg-success bg-opacity-10 rounded p-3">
                        <i class="bi bi-cash-stack text-success fs-2"></i>
                    </div>
                    <h5 class="text-muted mb-0">Ingresos</h5>
                </div>
                <h2 class="fw-bold mb-1">@Model.IngresosTotales.ToString("C0")</h2>
                <small class="text-muted">
                    Mes actual: @Model.IngresosMesActual.ToString("C0")
                </small>
            </div>
        </div>
    </div>

    <!-- Reservas Activas -->
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="stat-icon bg-info bg-opacity-10 rounded p-3">
                        <i class="bi bi-check-circle text-info fs-2"></i>
                    </div>
                    <h5 class="text-muted mb-0">Confirmadas</h5>
                </div>
                <h2 class="fw-bold mb-1">@Model.ReservasActivas</h2>
                <small class="text-muted">
                    Pendientes: @Model.ReservasPendientes
                </small>
            </div>
        </div>
    </div>

    <!-- Tasa de Conversión -->
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="stat-icon bg-warning bg-opacity-10 rounded p-3">
                        <i class="bi bi-graph-up text-warning fs-2"></i>
                    </div>
                    <h5 class="text-muted mb-0">Conversión</h5>
                </div>
                <h2 class="fw-bold mb-1">@Model.TasaConversion.ToString("F1")%</h2>
                <small class="text-muted">
                    Cancelación: @Model.TasaCancelacion.ToString("F1")%
                </small>
            </div>
        </div>
    </div>
</div>

<!-- Gráficas -->
<div class="row g-4 mb-4">
    <!-- Gráfica de Reservas por Mes -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-graph-up me-2 text-primary"></i>
                    Tendencia de Reservas
                </h5>
            </div>
            <div class="card-body">
                <canvas id="reservasChart" height="100"></canvas>
            </div>
        </div>
    </div>

    <!-- Gráfica de Reservas por Tipo -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-pie-chart me-2 text-primary"></i>
                    Por Tipo
                </h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="tipoChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Top Rankings y Actividad Reciente -->
<div class="row g-4 mb-4">
    <!-- Top 5 Hospedajes -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-trophy me-2 text-warning"></i>
                    Top 5 Hospedajes
                </h5>
            </div>
            <div class="card-body">
                @if (Model.TopHospedajes.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var (item, index) in Model.TopHospedajes.Select((h, i) => (h, i)))
                        {
                            <div class="list-group-item border-0 px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge bg-primary rounded-circle p-2 fs-6" style="width: 40px; height: 40px;">
                                            @(index + 1)
                                        </span>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.Nombre</h6>
                                            <small class="text-muted">@item.Ubicacion</small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-success">@item.IngresoTotal.ToString("C0")</div>
                                        <small class="text-muted">@item.CantidadReservas reservas</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">No hay datos disponibles</p>
                }
            </div>
        </div>
    </div>

    <!-- Top 5 Tours -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-trophy me-2 text-success"></i>
                    Top 5 Tours
                </h5>
            </div>
            <div class="card-body">
                @if (Model.TopTours.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var (item, index) in Model.TopTours.Select((t, i) => (t, i)))
                        {
                            <div class="list-group-item border-0 px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge bg-success rounded-circle p-2 fs-6" style="width: 40px; height: 40px;">
                                            @(index + 1)
                                        </span>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.Nombre</h6>
                                            <small class="text-muted">@item.Ubicacion</small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-success">@item.IngresoTotal.ToString("C0")</div>
                                        <small class="text-muted">@item.CantidadReservas reservas</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">No hay datos disponibles</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Actividad Reciente -->
<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-clock-history me-2 text-info"></i>
                    Actividad Reciente
                </h5>
            </div>
            <div class="card-body">
                @if (Model.UltimasReservas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Item</th>
                                    <th>Tipo</th>
                                    <th>Total</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reserva in Model.UltimasReservas)
                                {
                                    <tr>
                                        <td><code>#@reserva.Id</code></td>
                                        <td>@reserva.Item</td>
                                        <td>
                                            <span class="badge bg-@(reserva.Tipo == "Hospedaje" ? "primary" : reserva.Tipo == "Tour" ? "success" : "warning")">
                                                @reserva.Tipo
                                            </span>
                                        </td>
                                        <td><strong>@reserva.Total.ToString("C")</strong></td>
                                        <td><small>@reserva.Fecha.ToString("dd/MM/yyyy HH:mm")</small></td>
                                        <td>
                                            <span class="badge bg-@(reserva.Estado == "Confirmada" ? "success" : reserva.Estado == "Pendiente" ? "warning" : "secondary")">
                                                @reserva.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">No hay actividad reciente</p>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .stat-card {
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
        }

        .stat-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .list-group-item {
            transition: background-color 0.2s ease;
        }

        .list-group-item:hover {
            background-color: #f8f9fa;
        }
    </style>
}

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        // Datos desde el modelo
        const reservasPorMes = @Html.Raw(Json.Serialize(Model.ReservasPorMes));
        const reservasPorTipo = @Html.Raw(Json.Serialize(Model.ReservasPorTipo));

        // Gráfica de Línea: Reservas por Mes
        const ctxReservas = document.getElementById('reservasChart').getContext('2d');
        new Chart(ctxReservas, {
            type: 'line',
            data: {
                labels: reservasPorMes.map(m => m.mes),
                datasets: [{
                    label: 'Reservas',
                    data: reservasPorMes.map(m => m.cantidad),
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.4,
                    fill: true
                }, {
                    label: 'Ingresos (?)',
                    data: reservasPorMes.map(m => m.monto),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    tension: 0.4,
                    fill: true,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label === 'Ingresos (?)') {
                                    label += ': ' + new Intl.NumberFormat('es-CR', { 
                                        style: 'currency', 
                                        currency: 'CRC' 
                                    }).format(context.parsed.y);
                                } else {
                                    label += ': ' + context.parsed.y;
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Cantidad de Reservas'
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Ingresos (?)'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    }
                }
            }
        });

        // Gráfica de Dona: Reservas por Tipo
        const ctxTipo = document.getElementById('tipoChart').getContext('2d');
        new Chart(ctxTipo, {
            type: 'doughnut',
            data: {
                labels: Object.keys(reservasPorTipo),
                datasets: [{
                    data: Object.values(reservasPorTipo),
                    backgroundColor: [
                        '#667eea',
                        '#10b981',
                        '#f59e0b'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // Auto-refresh cada 5 minutos
        setTimeout(() => {
            location.reload();
        }, 5 * 60 * 1000);
    </script>
}
