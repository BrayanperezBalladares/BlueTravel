@{
    ViewData["Title"] = "Reportes Administrativos";
}

<!-- Header -->
<div class="dashboard-header bg-gradient-info text-white py-4 mb-4 rounded">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-2">
                    <i class="bi bi-file-earmark-text me-2"></i>Reportes
                </h1>
                <p class="lead mb-0">Genera y descarga informes detallados del sistema</p>
            </div>
            <div class="col-md-4 text-end">
                <small class="d-block">Fecha actual</small>
                <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>
    </div>
</div>

<!-- Sección en Construcción -->
<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm text-center py-5">
                <div class="card-body">
                    <!-- Icono animado -->
                    <div class="mb-4">
                        <i class="bi bi-tools text-primary" style="font-size: 5rem;"></i>
                    </div>

                    <!-- Título -->
                    <h2 class="fw-bold mb-3">Sección en Construcción</h2>
                    <p class="lead text-muted mb-4">
                        El módulo de reportes está siendo desarrollado y estará disponible próximamente.
                    </p>

                    <!-- Características planeadas -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <i class="bi bi-file-earmark-pdf text-danger fs-3 mb-2 d-block"></i>
                                <strong>Reportes PDF</strong>
                                <p class="small text-muted mb-0">Descarga informes en formato PDF</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <i class="bi bi-file-earmark-excel text-success fs-3 mb-2 d-block"></i>
                                <strong>Exportar a Excel</strong>
                                <p class="small text-muted mb-0">Exporta datos a hojas de cálculo</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <i class="bi bi-graph-up text-primary fs-3 mb-2 d-block"></i>
                                <strong>Análisis de Ventas</strong>
                                <p class="small text-muted mb-0">Reportes detallados de ingresos</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <i class="bi bi-people text-info fs-3 mb-2 d-block"></i>
                                <strong>Estadísticas de Clientes</strong>
                                <p class="small text-muted mb-0">Análisis de comportamiento de usuarios</p>
                            </div>
                        </div>
                    </div>

                    <!-- Botón volver -->
                    <a asp-action="Dashboard" class="btn btn-primary rounded-pill px-5">
                        <i class="bi bi-arrow-left me-2"></i>Volver al Dashboard
                    </a>
                </div>
            </div>

            <!-- Mensaje temporal -->
            <div class="alert alert-info border-0 shadow-sm mt-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle fs-4 me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-1">Mientras tanto...</h5>
                        <p class="mb-0">
                            Puedes acceder a las estadísticas en el 
                            <a asp-action="Dashboard" class="alert-link">Dashboard principal</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-info {
            background: linear-gradient(135deg, #36d1dc 0%, #5b86e5 100%);
        }

        .bi-tools {
            animation: rotate 3s linear infinite;
        }

        @@keyframes rotate {
            0% { transform: rotate(0deg); }
            25% { transform: rotate(-10deg); }
            50% { transform: rotate(10deg); }
            75% { transform: rotate(-10deg); }
            100% { transform: rotate(0deg); }
        }
    </style>
}
