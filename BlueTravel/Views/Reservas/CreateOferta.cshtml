@model BlueTravel.Models.Reserva

@{
    ViewData["Title"] = "Reservar Oferta";
    var oferta = ViewBag.Oferta as BlueTravel.Models.Oferta;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <h2 class="mb-0"><i class="bi bi-percent-circle me-2"></i>Reservar Oferta Especial</h2>
                </div>

                <div class="card-body p-5">
                    <!-- Info de la Oferta -->
                    <div class="alert alert-success border-0 mb-4">
                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-tag-fill fs-1 text-success"></i>
                            <div>
                                <h4 class="mb-2">@oferta?.Titulo</h4>
                                <p class="mb-2">@oferta?.Descripcion</p>
                                <p class="mb-0">
                                    <strong>Vigencia:</strong> @oferta?.FechaInicio.ToString("dd/MM/yyyy") - @oferta?.FechaFin.ToString("dd/MM/yyyy")
                                </p>
                            </div>
                        </div>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 mb-4">
                            <h5><i class="bi bi-exclamation-triangle-fill me-2"></i>Errores</h5>
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <small class="d-block mb-1">@error.ErrorMessage</small>
                                }
                            }
                        </div>
                    }

                    <form asp-action="CreateOferta" asp-controller="Reservas" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="TipoReserva" value="Oferta" />
                        <input type="hidden" name="ItemId" value="@Model.ItemId" />

                        <!-- SOLO UNA SECCIÓN SIMPLE -->
                        <div class="card mb-4 border-light bg-light">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Información de la Reserva</h5>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info mb-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>Nota:</strong> Esta oferta incluye todo lo descrito. Solo necesitas confirmar tu reserva.
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Número de Personas (Opcional)</label>
                                    <input asp-for="CantidadAdultos" type="number" class="form-control form-control-lg"
                                           min="1" value="1" placeholder="Ej: 2 personas" />
                                    <small class="text-muted">Indica cuántas personas usarán esta oferta</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Fecha Deseada (Opcional)</label>
                                    <input asp-for="FechaInicio" type="date" class="form-control form-control-lg"
                                           min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                                    <small class="text-muted">¿Cuándo planeas usar esta oferta?</small>
                                </div>
                            </div>
                        </div>

                        <!-- Precio -->
                        <div class="card mb-4 border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Precio de la Oferta</h5>
                            </div>
                            <div class="card-body text-center">
                                <div class="display-3 text-success fw-bold mb-2">
                                    @oferta?.Precio.ToString("C")
                                </div>
                                <p class="text-muted mb-0">Precio fijo - Todo incluido</p>
                            </div>
                        </div>

                        <!-- Comentarios -->
                        <div class="mb-3">
                            <label asp-for="Comentarios" class="form-label fw-semibold">Comentarios o Preguntas</label>
                            <textarea asp-for="Comentarios" class="form-control" rows="3" 
                                      placeholder="¿Tienes alguna pregunta sobre la oferta?"></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill">
                                <i class="bi bi-check-circle me-2"></i>Confirmar Reserva de Oferta
                            </button>
                            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg rounded-pill">
                                <i class="bi bi-arrow-left me-2"></i>Volver
                            </a>
                        </div>

                        <p class="text-center text-muted small mt-3 mb-0">
                            ? Precio fijo garantizado
                            <br />? Todo incluido según descripción
                        </p>
                    </form>
                </div>
            </div>

            <!-- Detalles de la Oferta -->
            <div class="card mt-4 border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="bi bi-list-check text-success me-2"></i>¿Qué Incluye?</h6>
                    <p class="text-muted small mb-0">@oferta?.Descripcion</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-header {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
