@model BlueTravel.Models.Tour

@{
    ViewData["Title"] = "Crear Tour";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-plus-circle me-2"></i>
                        Crear Nuevo Tour
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control form-control-lg" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-bold"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Ubicacion" class="form-label fw-bold"></label>
                                <input asp-for="Ubicacion" class="form-control" />
                                <span asp-validation-for="Ubicacion" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NivelDificultad" class="form-label fw-bold"></label>
                                <select asp-for="NivelDificultad" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option value="Fácil">Fácil</option>
                                    <option value="Moderado">Moderado</option>
                                    <option value="Difícil">Difícil</option>
                                </select>
                                <span asp-validation-for="NivelDificultad" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Precio" class="form-label fw-bold">Precio Adulto</label>
                                <div class="input-group">
                                    <span class="input-group-text">?</span>
                                    <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Precio" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PrecioNino" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">?</span>
                                    <input asp-for="PrecioNino" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="PrecioNino" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PrecioSenior" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">?</span>
                                    <input asp-for="PrecioSenior" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="PrecioSenior" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="CupoMaximo" class="form-label fw-bold"></label>
                                <input asp-for="CupoMaximo" class="form-control" type="number" />
                                <span asp-validation-for="CupoMaximo" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Duracion" class="form-label fw-bold">Duración (días)</label>
                                <input asp-for="Duracion" class="form-control" type="number" />
                                <span asp-validation-for="Duracion" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="DescuentoGrupo" class="form-label fw-bold">Descuento Grupo (%)</label>
                                <input asp-for="DescuentoGrupo" class="form-control" type="number" />
                                <span asp-validation-for="DescuentoGrupo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaDisponible" class="form-label fw-bold"></label>
                                <input asp-for="FechaDisponible" class="form-control" type="date" />
                                <span asp-validation-for="FechaDisponible" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="EdadMinima" class="form-label fw-bold"></label>
                                <input asp-for="EdadMinima" class="form-control" type="number" />
                                <span asp-validation-for="EdadMinima" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="EdadMaxima" class="form-label fw-bold"></label>
                                <input asp-for="EdadMaxima" class="form-control" type="number" />
                                <span asp-validation-for="EdadMaxima" class="text-danger"></span>
                                <small class="text-muted">Dejar vacío si no hay límite</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImagenUrl" class="form-label fw-bold"></label>
                            <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                            <small class="text-muted">URL de la imagen (ej: desde Unsplash)</small>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="RequiereConfirmacion" class="form-check-input" />
                                <label asp-for="RequiereConfirmacion" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="bi bi-check-circle me-2"></i>Crear Tour
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
