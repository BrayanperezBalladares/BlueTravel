@model BlueTravel.Models.Pago

@{
    ViewData["Title"] = "¡Pago Exitoso!";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <!-- Animación de éxito -->
            <div class="text-center mb-5">
                <div class="success-checkmark mb-4">
                    <div class="check-icon">
                        <span class="icon-line line-tip"></span>
                        <span class="icon-line line-long"></span>
                        <div class="icon-circle"></div>
                        <div class="icon-fix"></div>
                    </div>
                </div>
                <h1 class="display-4 text-success mb-3">¡Pago Exitoso!</h1>
                <p class="lead text-muted">
                    Tu pago ha sido procesado correctamente
                </p>
            </div>

            <!-- Detalles del pago -->
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt"></i> Comprobante de Pago
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <small class="text-muted">ID DE TRANSACCIÓN</small>
                            <h4><code>@Model.TransaccionExternaId</code></h4>
                        </div>
                        <div class="col-md-6 text-end">
                            <small class="text-muted">MONTO PAGADO</small>
                            <h2 class="text-success mb-0">@Model.TotalPagado.ToString("C")</h2>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Método de Pago:</strong> @Model.Metodo</p>
                            <p><strong>Estado:</strong> 
                                <span class="badge bg-success">Aprobado</span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Fecha:</strong> @Model.FechaAprobacion?.ToString("dd/MM/yyyy HH:mm")</p>
                            @if (Model.Reserva != null)
                            {
                                <p><strong>Reserva:</strong> #@Model.ReservaId</p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.TransaccionExternaId) && Model.TransaccionExternaId.StartsWith("pi_"))
                    {
                        <div class="alert alert-info mt-3">
                            <i class="bi bi-stripe"></i>
                            <strong>Procesado con Stripe</strong><br />
                            <small>
                                Tu pago ha sido procesado de forma segura a través de Stripe.
                                <a href="https://dashboard.stripe.com/test/payments/@Model.TransaccionExternaId" 
                                   target="_blank" class="alert-link">
                                    Ver detalles en Stripe <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </small>
                        </div>
                    }
                </div>
            </div>

            <!-- Próximos pasos -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle text-primary"></i> ¿Qué sigue?
                    </h5>
                    <ul class="list-unstyled mt-3">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Recibirás un email de confirmación en breve
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Tu reserva ha sido confirmada automáticamente
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Puedes descargar este comprobante en cualquier momento
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Acciones -->
            <div class="d-grid gap-2">
                <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-primary btn-lg">
                    <i class="bi bi-download"></i> Descargar Comprobante
                </a>
                @if (Model.Reserva != null)
                {
                    <a href="@Url.Action("Details", "Reservas", new { id = Model.ReservaId })" 
                       class="btn btn-outline-primary">
                        <i class="bi bi-calendar-check"></i> Ver Mi Reserva
                    </a>
                }
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    <i class="bi bi-house"></i> Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .success-checkmark {
            width: 80px;
            height: 115px;
            margin: 0 auto;
        }

        .success-checkmark .check-icon {
            width: 80px;
            height: 80px;
            position: relative;
            border-radius: 50%;
            box-sizing: content-box;
            border: 4px solid #198754;
            background: #fff;
        }

        .success-checkmark .check-icon .icon-line {
            height: 5px;
            background-color: #198754;
            display: block;
            border-radius: 2px;
            position: absolute;
            z-index: 10;
        }

        .success-checkmark .check-icon .icon-line.line-tip {
            top: 46px;
            left: 14px;
            width: 25px;
            transform: rotate(45deg);
        }

        .success-checkmark .check-icon .icon-line.line-long {
            top: 38px;
            right: 8px;
            width: 47px;
            transform: rotate(-45deg);
        }
    </style>
}
