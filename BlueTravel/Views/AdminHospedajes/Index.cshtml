@model IEnumerable<BlueTravel.Models.Hospedaje>

@{
    ViewData["Title"] = "Gestión de Hospedajes";
}

<div class="container-fluid my-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold">
                <i class="bi bi-building text-primary me-2"></i>
                Gestión de Hospedajes
            </h1>
            <p class="text-muted mb-0">Administra todos los hospedajes del sistema</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-4">
            <i class="bi bi-plus-circle me-2"></i>Nuevo Hospedaje
        </a>
    </div>

    <!-- Estadísticas rápidas -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="text-muted">Total Hospedajes</h5>
                    <h2 class="fw-bold text-primary">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="text-muted">Precio Promedio</h5>
                    <h2 class="fw-bold text-success">@Model.Average(h => h.PrecioPorNoche).ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="text-muted">Capacidad Total</h5>
                    <h2 class="fw-bold text-info">@Model.Sum(h => h.CapacidadMaxima) personas</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Ubicación</th>
                            <th>Tipo</th>
                            <th>Precio/Noche</th>
                            <th>Capacidad</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.Id</strong></td>
                                <td>
                                    <strong>@item.Nombre</strong>
                                </td>
                                <td>
                                    <i class="bi bi-geo-alt text-danger"></i>
                                    @item.Ubicacion
                                </td>
                                <td>
                                    <span class="badge bg-primary">@item.TipoHospedaje</span>
                                </td>
                                <td class="fw-bold text-success">@item.PrecioPorNoche.ToString("C")</td>
                                <td>
                                    <i class="bi bi-people"></i>
                                    @item.CapacidadMaxima personas
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                           class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" 
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('¿Eliminar @item.Nombre?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
