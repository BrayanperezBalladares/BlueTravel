@{
    ViewData["Title"] = "Inicio - BlueTravel";
}

<!-- Hero Section Premium -->
<section class="hero-premium position-relative overflow-hidden">
    <div class="hero-bg-pattern"></div>
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6 hero-content" data-aos="fade-right">
                <span class="badge bg-gradient-primary px-4 py-2 mb-3 rounded-pill">
                    <i class="bi bi-star-fill me-2"></i>Experiencias Premium en Costa Rica
                </span>
                <h1 class="display-2 fw-bold mb-4 gradient-text">
                    Descubre la Magia de
                    <span class="text-primary d-block">Guanacaste</span>
                </h1>
                <p class="lead text-muted mb-4 fs-5">
                    Vive experiencias únicas en playas paradisíacas, tours inolvidables 
                    y la mejor gastronomía costarricense. Tu aventura comienza aquí.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/Catalogo/Hospedajes" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-lg hover-lift">
                        <i class="bi bi-house-heart me-2"></i>Explorar Hospedajes
                    </a>
                    <a href="/Catalogo/Tours" class="btn btn-outline-primary btn-lg px-5 py-3 rounded-pill hover-lift">
                        <i class="bi bi-compass me-2"></i>Ver Tours
                    </a>
                </div>
                
                <!-- Stats rápidas -->
                <div class="row mt-5 g-4">
                    <div class="col-4">
                        <div class="stat-card">
                            <h3 class="fw-bold text-primary mb-0">50+</h3>
                            <small class="text-muted">Destinos</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card">
                            <h3 class="fw-bold text-primary mb-0">10k+</h3>
                            <small class="text-muted">Viajeros Felices</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card">
                            <h3 class="fw-bold text-primary mb-0">4.9</h3>
                            <small class="text-muted">Calificación</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block" data-aos="fade-left">
                <div class="hero-image-container">
                    <img src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&h=600&fit=crop" 
                         alt="Guanacaste Beach" 
                         class="img-fluid rounded-4 shadow-2xl floating-image">
                    <div class="floating-card card shadow-lg">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                                <i class="bi bi-shield-check text-primary fs-3"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Pagos Seguros</h6>
                                <small class="text-muted">Powered by Stripe</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Decoración de fondo -->
    <div class="hero-decoration"></div>
</section>

<!-- Por qué elegirnos - Rediseñado -->
<section class="features-section py-5">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="badge bg-primary bg-opacity-10 text-primary px-4 py-2 mb-3">
                Nuestras Ventajas
            </span>
            <h2 class="display-5 fw-bold mb-3">¿Por qué BlueTravel?</h2>
            <p class="text-muted fs-5">Más de 10 años conectando viajeros con experiencias inolvidables</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-card card border-0 shadow-sm h-100 hover-lift">
                    <div class="card-body p-4">
                        <div class="feature-icon bg-primary bg-opacity-10 d-inline-flex p-4 rounded-4 mb-4">
                            <i class="bi bi-credit-card-2-front text-primary fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Pagos Flexibles</h4>
                        <p class="text-muted mb-0">
                            Paga con tarjeta, SINPE Móvil o PayPal. Procesamiento seguro con Stripe.
                            Sin cargos ocultos.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-card card border-0 shadow-sm h-100 hover-lift">
                    <div class="card-body p-4">
                        <div class="feature-icon bg-success bg-opacity-10 d-inline-flex p-4 rounded-4 mb-4">
                            <i class="bi bi-headset text-success fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Soporte 24/7</h4>
                        <p class="text-muted mb-0">
                            Nuestro equipo está disponible todos los días para ayudarte antes, 
                            durante y después de tu viaje.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-card card border-0 shadow-sm h-100 hover-lift">
                    <div class="card-body p-4">
                        <div class="feature-icon bg-warning bg-opacity-10 d-inline-flex p-4 rounded-4 mb-4">
                            <i class="bi bi-award text-warning fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Mejor Precio Garantizado</h4>
                        <p class="text-muted mb-0">
                            Encontramos el mejor precio o te devolvemos el doble de la diferencia. 
                            Así de simple.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

