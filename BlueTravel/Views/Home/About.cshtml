@{
    ViewData["Title"] = "Sobre Nosotros - BlueTravel";
}

<!-- Hero About -->
<section class="about-hero position-relative text-white overflow-hidden py-5">
    <div class="hero-overlay"></div>
    <div class="container position-relative z-2 py-5">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="badge bg-white text-primary px-4 py-2 mb-3 rounded-pill">
                    Desde 2014
                </span>
                <h1 class="display-2 fw-bold mb-4">
                    Creando Experiencias
                    <span class="d-block text-warning">Inolvidables</span>
                </h1>
                <p class="lead fs-4 mb-4">
                    Somos más que una agencia de viajes. Somos tu compañero de aventuras 
                    en la hermosa región de Guanacaste, Costa Rica.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Nuestra Historia -->
<section class="our-story py-5">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6 mb-4 mb-lg-0" data-aos="fade-right">
                <img src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&h=600&fit=crop" 
                     alt="Nuestra Historia" class="img-fluid rounded-4 shadow-lg">
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <span class="badge bg-primary bg-opacity-10 text-primary px-4 py-2 mb-3">
                    Nuestra Historia
                </span>
                <h2 class="display-4 fw-bold mb-4">Todo comenzó con un sueño</h2>
                <p class="lead text-muted mb-3">
                    En 2014, un grupo de apasionados viajeros decidió crear algo especial: 
                    una plataforma que conectara a personas con las experiencias más auténticas 
                    de Costa Rica.
                </p>
                <p class="text-muted mb-4">
                    Hoy, después de 10 años, hemos ayudado a más de 10,000 viajeros a descubrir 
                    la magia de Guanacaste, desde sus playas paradisíacas hasta sus volcanes 
                    majestuosos y su rica cultura.
                </p>
                <div class="row g-4">
                    <div class="col-6">
                        <div class="stat-box text-center p-3 bg-light rounded-3">
                            <h3 class="display-5 fw-bold text-primary mb-0">10K+</h3>
                            <small class="text-muted">Viajeros Felices</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box text-center p-3 bg-light rounded-3">
                            <h3 class="display-5 fw-bold text-success mb-0">50+</h3>
                            <small class="text-muted">Destinos</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Valores -->
<section class="values-section bg-light py-5">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="badge bg-primary bg-opacity-10 text-primary px-4 py-2 mb-3">
                Nuestros Valores
            </span>
            <h2 class="display-4 fw-bold mb-3">Lo que nos mueve</h2>
            <p class="lead text-muted">Principios que guían cada decisión que tomamos</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4" data-aos="zoom-in">
                <div class="value-card card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-4">
                        <div class="value-icon bg-primary bg-opacity-10 rounded-circle p-4 d-inline-flex mb-3">
                            <i class="bi bi-heart-fill text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Pasión</h4>
                        <p class="text-muted">
                            Amamos lo que hacemos y se refleja en cada experiencia que creamos
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="100">
                <div class="value-card card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-4">
                        <div class="value-icon bg-success bg-opacity-10 rounded-circle p-4 d-inline-flex mb-3">
                            <i class="bi bi-shield-check text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Confianza</h4>
                        <p class="text-muted">
                            Tu seguridad y satisfacción son nuestra prioridad número uno
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="200">
                <div class="value-card card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-4">
                        <div class="value-icon bg-warning bg-opacity-10 rounded-circle p-4 d-inline-flex mb-3">
                            <i class="bi bi-stars text-warning" style="font-size: 3rem;"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Excelencia</h4>
                        <p class="text-muted">
                            Buscamos constantemente superar las expectativas de nuestros clientes
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Timeline -->
<section class="timeline-section py-5">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="badge bg-primary bg-opacity-10 text-primary px-4 py-2 mb-3">
                Nuestro Crecimiento
            </span>
            <h2 class="display-4 fw-bold">Una Década de Éxitos</h2>
        </div>

        <div class="timeline">
            <div class="timeline-item" data-aos="fade-right">
                <div class="timeline-marker bg-primary"></div>
                <div class="timeline-content card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <span class="badge bg-primary mb-2">2014</span>
                        <h4 class="fw-bold">Fundación de BlueTravel</h4>
                        <p class="text-muted mb-0">
                            Iniciamos operaciones con 5 hospedajes y 10 tours en Guanacaste
                        </p>
                    </div>
                </div>
            </div>

            <div class="timeline-item" data-aos="fade-left">
                <div class="timeline-marker bg-success"></div>
                <div class="timeline-content card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <span class="badge bg-success mb-2">2016</span>
                        <h4 class="fw-bold">Expansión Nacional</h4>
                        <p class="text-muted mb-0">
                            Alcanzamos los 1,000 viajeros atendidos y expandimos a toda Costa Rica
                        </p>
                    </div>
                </div>
            </div>

            <div class="timeline-item" data-aos="fade-right">
                <div class="timeline-marker bg-warning"></div>
                <div class="timeline-content card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <span class="badge bg-warning text-dark mb-2">2019</span>
                        <h4 class="fw-bold">Plataforma Digital</h4>
                        <p class="text-muted mb-0">
                            Lanzamiento de nuestra plataforma online con sistema de reservas
                        </p>
                    </div>
                </div>
            </div>

            <div class="timeline-item" data-aos="fade-left">
                <div class="timeline-marker bg-danger"></div>
                <div class="timeline-content card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <span class="badge bg-danger mb-2">2024</span>
                        <h4 class="fw-bold">Integración con Stripe</h4>
                        <p class="text-muted mb-0">
                            Implementamos pagos seguros y alcanzamos 10,000+ clientes satisfechos
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

