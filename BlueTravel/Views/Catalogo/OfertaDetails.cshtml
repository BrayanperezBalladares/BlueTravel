@model BlueTravel.Models.Oferta

@{
    ViewData["Title"] = Model.Titulo;
}

<!-- Oferta Details Page -->
<section class="oferta-details-page py-5">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="Catalogo" asp-action="Ofertas">Ofertas</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Titulo</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Left Column: Images & Info -->
            <div class="col-lg-8">
                <!-- Main Image -->
                <div class="oferta-image-wrapper mb-4" data-aos="fade-up">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200&h=600&fit=crop" 
                             alt="@Model.Titulo" 
                             class="w-100 rounded-3 shadow-lg"
                             style="height: 500px; object-fit: cover;">
                        
                        <!-- Discount Badge -->
                        <div class="position-absolute top-0 end-0 m-4">
                            <span class="badge bg-danger px-4 py-2 fs-5">
                                <i class="bi bi-tag-fill me-2"></i>Oferta Especial
                            </span>
                        </div>

                        <!-- Duration Badge -->
                        <div class="position-absolute bottom-0 start-0 m-4">
                            <span class="badge bg-dark bg-opacity-75 px-3 py-2">
                                <i class="bi bi-calendar-event me-2"></i>
                                @Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Oferta Info Tabs -->
                <div class="card border-0 shadow-sm mb-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="card-body p-4">
                        <ul class="nav nav-tabs mb-4" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#descripcion" type="button" role="tab">
                                    <i class="bi bi-info-circle me-2"></i>Descripción
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#condiciones" type="button" role="tab">
                                    <i class="bi bi-check2-square me-2"></i>Condiciones
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- Descripción Tab -->
                            <div class="tab-pane fade show active" id="descripcion" role="tabpanel">
                                <h4 class="fw-bold mb-3">@Model.Titulo</h4>
                                <p class="text-muted lead">@Model.Descripcion</p>

                                <div class="row g-3 mt-4">
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                                            <i class="bi bi-calendar-check fs-3 text-primary"></i>
                                            <div>
                                                <small class="text-muted d-block">Válido desde</small>
                                                <strong>@Model.FechaInicio.ToString("dd/MM/yyyy")</strong>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                                            <i class="bi bi-calendar-x fs-3 text-danger"></i>
                                            <div>
                                                <small class="text-muted d-block">Válido hasta</small>
                                                <strong>@Model.FechaFin.ToString("dd/MM/yyyy")</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Condiciones Tab -->
                            <div class="tab-pane fade" id="condiciones" role="tabpanel">
                                <h5 class="fw-bold mb-3">Términos y Condiciones</h5>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Oferta válida únicamente durante las fechas indicadas
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Sujeto a disponibilidad
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        No acumulable con otras promociones
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Cancelación gratuita hasta 48 horas antes
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                        No reembolsable después de la fecha de inicio
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Why Choose This Offer -->
                <div class="card border-0 shadow-sm" data-aos="fade-up" data-aos-delay="200">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">
                            <i class="bi bi-star-fill text-warning me-2"></i>
                            ¿Por qué elegir esta oferta?
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                    <div>
                                        <strong class="d-block mb-1">Mejor Precio Garantizado</strong>
                                        <small class="text-muted">No encontrarás un precio mejor en otro lugar</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                    <div>
                                        <strong class="d-block mb-1">Cancelación Flexible</strong>
                                        <small class="text-muted">Cancela hasta 48 horas antes sin cargo</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                    <div>
                                        <strong class="d-block mb-1">Confirmación Inmediata</strong>
                                        <small class="text-muted">Recibe tu confirmación al instante</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                    <div>
                                        <strong class="d-block mb-1">Atención 24/7</strong>
                                        <small class="text-muted">Soporte disponible en todo momento</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Booking Card -->
            <div class="col-lg-4">
                <div class="booking-card sticky-top" style="top: 100px;" data-aos="fade-left">
                    <div class="card border-0 shadow-lg">
                        <div class="card-body p-4">
                            <!-- Price -->
                            <div class="text-center mb-4">
                                <small class="text-muted d-block">Precio especial</small>
                                <h2 class="display-4 fw-bold text-primary mb-0">@Model.Precio.ToString("C")</h2>
                                <small class="text-muted">Por persona</small>
                            </div>

                            <hr class="my-4">

                            <!-- Validity -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3">
                                    <i class="bi bi-clock me-2"></i>Validez de la Oferta
                                </h6>
                                <div class="alert alert-warning mb-0">
                                    <small>
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        ¡Oferta válida hasta el @Model.FechaFin.ToString("dd/MM/yyyy")!
                                    </small>
                                </div>
                            </div>

                            <!-- CTA Button -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Reservas" 
                                   asp-action="CreateOferta" 
                                   asp-route-id="@Model.Id"
                                   class="btn btn-lg btn-primary w-100 rounded-pill py-3 fw-bold mb-3">
                                    <i class="bi bi-cart-check me-2"></i>
                                    Reservar Ahora
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account" 
                                   asp-action="Login" 
                                   asp-route-returnUrl="@($"/Catalogo/Details?tipo=oferta&id={Model.Id}")"
                                   class="btn btn-lg btn-primary w-100 rounded-pill py-3 fw-bold mb-3">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    Inicia Sesión para Reservar
                                </a>
                            }

                            <!-- Additional Info -->
                            <div class="d-grid gap-2">
                                <small class="text-center text-muted">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Pago seguro y protegido
                                </small>
                                <small class="text-center text-muted">
                                    <i class="bi bi-award me-1"></i>
                                    Satisfacción garantizada
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Card -->
                    <div class="card border-0 shadow-sm mt-4">
                        <div class="card-body p-4 text-center">
                            <i class="bi bi-headset fs-1 text-primary mb-3"></i>
                            <h6 class="fw-bold mb-2">¿Necesitas ayuda?</h6>
                            <p class="text-muted small mb-3">
                                Nuestro equipo está disponible para ayudarte
                            </p>
                            <a href="#" class="btn btn-outline-primary rounded-pill">
                                <i class="bi bi-telephone me-2"></i>Contactar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- More Offers Section -->
        <section class="more-offers mt-5" data-aos="fade-up">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">Otras Ofertas Especiales</h3>
                <a asp-controller="Catalogo" asp-action="Ofertas" class="btn btn-outline-primary rounded-pill">
                    Ver Todas
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
            
            <p class="text-muted">
                <i class="bi bi-info-circle me-2"></i>
                Descubre más ofertas increíbles en nuestro catálogo
            </p>
        </section>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">
    <style>
        .oferta-details-page {
            background: #f8f9fa;
        }

        .oferta-image-wrapper img {
            transition: all 0.3s ease;
        }

        .oferta-image-wrapper:hover img {
            transform: scale(1.02);
        }

        .booking-card {
            z-index: 10;
        }

        .nav-tabs .nav-link {
            color: #6c757d;
            border: none;
            border-bottom: 3px solid transparent;
            font-weight: 600;
        }

        .nav-tabs .nav-link:hover {
            border-bottom-color: #667eea;
        }

        .nav-tabs .nav-link.active {
            color: #667eea;
            border-bottom-color: #667eea;
            background: transparent;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }

        /* Sticky booking card on scroll */
        @@media (min-width: 992px) {
            .sticky-top {
                position: sticky;
                top: 100px;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ 
            duration: 600, 
            once: true 
        });
    </script>
}
