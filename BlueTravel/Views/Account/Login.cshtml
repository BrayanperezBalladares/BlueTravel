@model BlueTravel.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    var showMessage = !string.IsNullOrEmpty(returnUrl);
}

<!-- Login Page Premium -->
<section class="login-page min-vh-100 d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="login-card card border-0 shadow-2xl overflow-hidden">
                    <div class="row g-0">
                        <!-- Left Side: Image/Branding -->
                        <div class="col-lg-6 d-none d-lg-block">
                            <div class="login-image-side h-100 position-relative">
                                <img src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&h=1000&fit=crop" 
                                     alt="BlueTravel" class="w-100 h-100 object-cover">
                                <div class="login-overlay"></div>
                                <div class="login-brand-content position-absolute top-50 start-50 translate-middle text-center">
                                    <div class="logo-circle-large mb-4">
                                        <i class="bi bi-airplane-fill"></i>
                                    </div>
                                    <h2 class="text-white fw-bold mb-3">Bienvenido a BlueTravel</h2>
                                    <p class="text-white-50 lead">Tu próxima aventura comienza aquí</p>
                                    <div class="mt-4">
                                        <div class="d-flex justify-content-center gap-4 text-white small">
                                            <div>
                                                <i class="bi bi-check-circle-fill me-2"></i>50+ Destinos
                                            </div>
                                            <div>
                                                <i class="bi bi-check-circle-fill me-2"></i>10k+ Clientes
                                            </div>
                                            <div>
                                                <i class="bi bi-check-circle-fill me-2"></i>4.9★
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Side: Login Form -->
                        <div class="col-lg-6">
                            <div class="login-form-side p-5">
                                <!-- Context Message -->
                                @if (showMessage)
                                {
                                    <div class="alert alert-info border-0 shadow-sm mb-4" data-aos="fade-down">
                                        <div class="d-flex align-items-center gap-3">
                                            <i class="bi bi-info-circle-fill fs-3"></i>
                                            <div>
                                                <strong>Inicia sesión para continuar</strong>
                                                <p class="mb-0 small">Necesitas una cuenta para hacer reservas</p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Header -->
                                <div class="text-center mb-4" data-aos="fade-down">
                                    <h1 class="fw-bold mb-2">Iniciar Sesión</h1>
                                    <p class="text-muted">Continúa tu viaje con nosotros</p>
                                </div>

                                <!-- Error Messages -->
                                <div asp-validation-summary="All" class="alert alert-danger border-0 shadow-sm mb-4" style="display:none;"></div>

                                <!-- Social Login Buttons -->
                                <div class="social-login mb-4" data-aos="fade-up" data-aos-delay="100">
                                    <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="provider" value="Google" />
                                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                                        <button type="submit" class="btn btn-google w-100 py-3 rounded-pill shadow-sm mb-3">
                                            <i class="bi bi-google me-2"></i>
                                            Continuar con Google
                                        </button>
                                    </form>
                                </div>

                                <!-- Divider -->
                                <div class="divider my-4" data-aos="fade-up" data-aos-delay="150">
                                    <span>o continúa con email</span>
                                </div>

                                <!-- Login Form -->
                                <form asp-action="Login" method="post" data-aos="fade-up" data-aos-delay="200">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                    
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label fw-semibold">
                                            <i class="bi bi-envelope me-2"></i>Correo Electrónico
                                        </label>
                                        <input asp-for="Email" 
                                               class="form-control form-control-lg rounded-pill" 
                                               placeholder="ejemplo@correo.com" 
                                               autocomplete="username" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Password" class="form-label fw-semibold">
                                            <i class="bi bi-lock me-2"></i>Contraseña
                                        </label>
                                        <div class="input-group">
                                            <input asp-for="Password" 
                                                   class="form-control form-control-lg rounded-pill" 
                                                   placeholder="••••••••" 
                                                   type="password"
                                                   id="passwordInput"
                                                   autocomplete="current-password" />
                                            <button class="btn btn-link position-absolute end-0 top-50 translate-middle-y z-3" 
                                                    type="button" 
                                                    onclick="togglePassword()"
                                                    style="border: none;">
                                                <i class="bi bi-eye" id="toggleIcon"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <div class="form-check">
                                            <input asp-for="RememberMe" class="form-check-input" />
                                            <label asp-for="RememberMe" class="form-check-label">
                                                Recordarme
                                            </label>
                                        </div>
                                        <a href="#" class="text-primary text-decoration-none">
                                            <small>¿Olvidaste tu contraseña?</small>
                                        </a>
                                    </div>

                                    <div class="d-grid mb-3">
                                        <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                                        </button>
                                    </div>
                                </form>

                                <!-- Register Link -->
                                <div class="text-center mt-4" data-aos="fade-up" data-aos-delay="250">
                                    <p class="text-muted mb-3">
                                        ¿No tienes cuenta? 
                                        <a asp-action="Register" asp-route-returnUrl="@returnUrl" class="text-primary fw-semibold text-decoration-none">
                                            Regístrate gratis
                                        </a>
                                    </p>
                                </div>

                                <!-- Admin Test Account -->
                                @if (Context.Request.Host.Host == "localhost")
                                {
                                    <div class="alert alert-light border shadow-sm mt-4" data-aos="fade-up" data-aos-delay="300">
                                        <div class="d-flex align-items-start gap-3">
                                            <i class="bi bi-info-circle text-primary fs-5"></i>
                                            <div>
                                                <strong class="d-block mb-2">Cuenta de prueba:</strong>
                                                <div class="d-flex flex-column gap-1 small">
                                                    <span><i class="bi bi-envelope me-2"></i>admin@bluetravel.com</span>
                                                    <span><i class="bi bi-key me-2"></i>Admin123!</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">
    <style>
        .login-page {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .login-card {
            border-radius: 1.5rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .login-image-side {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .object-cover {
            object-fit: cover;
        }

        .login-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.9) 0%, rgba(118, 75, 162, 0.9) 100%);
        }

        .logo-circle-large {
            width: 100px;
            height: 100px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
            margin: 0 auto;
            backdrop-filter: blur(10px);
        }

        .login-form-side {
            background: white;
        }

        /* Social Buttons */
        .btn-google {
            background: white;
            border: 2px solid #e0e0e0;
            color: #333;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-google:hover {
            background: #4285f4;
            color: white;
            border-color: #4285f4;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(66, 133, 244, 0.3);
        }

        .btn-facebook {
            background: #1877f2;
            border: none;
            color: white;
            font-weight: 600;
        }

        .btn-facebook:hover {
            background: #155db2;
        }

        /* Divider */
        .divider {
            position: relative;
            text-align: center;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #e0e0e0;
        }

        .divider span {
            position: relative;
            background: white;
            padding: 0 1rem;
            color: #6b7280;
            font-size: 0.875rem;
        }

        /* Form Controls */
        .form-control-lg {
            padding: 0.75rem 1.5rem;
        }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
        }

        /* Password Toggle */
        .input-group {
            position: relative;
        }

        #toggleIcon {
            cursor: pointer;
        }

        /* Responsive */
        @@media (max-width: 991px) {
            .login-form-side {
                padding: 2rem !important;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 600, once: true });

        // Toggle Password Visibility
        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        }

        // Show validation summary if there are errors
        const validationSummary = document.querySelector('[asp-validation-summary]');
        if (validationSummary && validationSummary.querySelectorAll('li').length > 0) {
            validationSummary.style.display = 'block';
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}